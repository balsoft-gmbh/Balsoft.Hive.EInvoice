<Project>

  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CA1716: "Invoice.Item" style names are the EN 16931 vocabulary, kept on purpose. -->
    <NoWarn>$(NoWarn);CA1716;CA1720;CA1002;CA2227;CA1056;CA1054;CA1034;CA1305</NoWarn>

    <Authors>Ertugrul Balveren</Authors>
    <Company>Balsoft GmbH</Company>
    <Copyright>Copyright (c) Balsoft GmbH</Copyright>
    <Product>Balsoft.Hive.EInvoice</Product>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ertugrulbalveren/Balsoft.Hive.EInvoice</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ertugrulbalveren/Balsoft.Hive.EInvoice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>xrechnung;zugferd;factur-x;en16931;e-invoice;einvoice;e-rechnung;cii;ubl;peppol;invoice;pdf-a-3</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
